# ─────────────────────────────────────────────
# MeetMind — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── Backend (place in /backend/.env) ──

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# JSON Web Token secret (use a long random string in production)
JWT_SECRET=change_me_in_production

# Google Gemini API key (used for AI extraction + audio transcription)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend origin for CORS (set to your Vercel URL in production)
CLIENT_URL=http://localhost:5173

# ── Frontend (set as Vercel Environment Variables) ──

# VITE_API_URL=https://your-backend.onrender.com/api
